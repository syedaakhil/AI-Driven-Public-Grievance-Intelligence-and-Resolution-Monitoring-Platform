msgid "%(taluk)s taluk"
msgstr "%(taluk)s तालुक"

msgid "Please sign in as a corporation admin to use the assistant."
msgstr "सहायक का उपयोग करने के लिए कृपया निगम प्रशासक के रूप में साइन इन करें।"

msgid "Too many messages. Please wait a minute and try again."
msgstr "बहुत अधिक संदेश। कृपया एक मिनट रुककर फिर से प्रयास करें।"

msgid "The message could not be read."
msgstr "संदेश पढ़ा नहीं जा सका।"

msgid "Type a message first."
msgstr "पहले कोई संदेश लिखें।"

#, python-format
msgid "Please keep the message under %(count)s characters."
msgstr "कृपया संदेश %(count)s अक्षरों से कम रखें।"

msgid "The database is not reachable right now. Please try again in a moment."
msgstr "डेटाबेस अभी उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर से प्रयास करें।"

msgid "Something went wrong on our side. Please try again."
msgstr "हमारी ओर से कुछ गड़बड़ हो गई। कृपया फिर से प्रयास करें।"

