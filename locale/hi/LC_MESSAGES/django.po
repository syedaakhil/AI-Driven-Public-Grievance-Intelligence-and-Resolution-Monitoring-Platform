msgid "Please verify your mobile number to continue."
msgstr "कृपया आगे बढ़ने के लिए अपना मोबाइल नंबर सत्यापित करें।"

#, python-format
msgid "Please wait %(seconds)s seconds before asking for another OTP."
msgstr "नया OTP माँगने से पहले कृपया %(seconds)s सेकंड प्रतीक्षा करें।"

msgid "Too many OTP requests for this number. Please try again in an hour."
msgstr "इस नंबर के लिए बहुत अधिक OTP अनुरोध हो चुके हैं। कृपया एक घंटे बाद फिर से प्रयास करें।"

msgid "We could not send the SMS right now. Please try again later."
msgstr "हम अभी SMS नहीं भेज सके। कृपया बाद में फिर से प्रयास करें।"

msgid "Please request an OTP first."
msgstr "कृपया पहले OTP का अनुरोध करें।"

msgid "This OTP has expired. Please request a new one."
msgstr "इस OTP की समय-सीमा समाप्त हो गई है। कृपया नया OTP माँगें।"

#, python-format
msgid "Enter the %(length)s-digit OTP."
msgstr "%(length)s अंकों का OTP दर्ज करें।"

msgid "Too many incorrect attempts. Please request a new OTP."
msgstr "बहुत अधिक गलत प्रयास। कृपया नया OTP माँगें।"

#, python-format
msgid "Incorrect OTP. %(left)s attempt left."
msgid_plural "Incorrect OTP. %(left)s attempts left."
msgstr[0] "गलत OTP। %(left)s प्रयास बाकी है।"
msgstr[1] "गलत OTP। %(left)s प्रयास बाकी हैं।"

msgid "Too many failed attempts. Please try again in 15 minutes."
msgstr "बहुत अधिक असफल प्रयास। कृपया 15 मिनट बाद फिर से प्रयास करें।"

msgid "This account still has a weak password, so it is blocked on the live site. Set a strong one with “manage.py changepassword”."
msgstr "इस खाते का पासवर्ड अभी भी कमज़ोर है, इसलिए लाइव साइट पर इसे रोक दिया गया है। “manage.py changepassword” से एक मज़बूत पासवर्ड सेट करें।"

msgid "Invalid username or password."
msgstr "उपयोगकर्ता नाम या पासवर्ड गलत है।"

msgid "Enter a valid 10-digit mobile number starting with 6, 7, 8 or 9."
msgstr "6, 7, 8 या 9 से शुरू होने वाला 10 अंकों का मान्य मोबाइल नंबर दर्ज करें।"

#, python-format
msgid "OTP sent to %(phone)s."
msgstr "OTP %(phone)s पर भेजा गया।"

msgid "You have been signed out."
msgstr "आप साइन आउट हो गए हैं।"

msgid ""
"Hi! I can search complaints and email them to the corporation inbox.\n"
"• Search by name, ID or words: “Lakshmi”, “CC-2026-00042”, “pothole Anna Nagar”\n"
"• Filter: “open complaints”, “resolved today”, “latest complaints”\n"
"• Email: “mail me this”, “email me the complaints of Ravi”\n"
"• Files: “mail me CC-2026-00042” also attaches that complaint’s photo and documents"
msgstr ""
"नमस्ते! मैं शिकायतें खोज सकता हूँ और उन्हें निगम के इनबॉक्स में ईमेल कर सकता हूँ।\n"
"• नाम, ID या शब्दों से खोजें: “Lakshmi”, “CC-2026-00042”, “pothole Anna Nagar”\n"
"• फ़िल्टर: “open complaints”, “resolved today”, “latest complaints”\n"
"• ईमेल: “mail me this”, “मुझे ईमेल भेजो”, “email me the complaints of Ravi”\n"
"• फ़ाइलें: “mail me CC-2026-00042” उस शिकायत की फ़ोटो और दस्तावेज़ भी साथ भेजता है"

msgid "Latest complaints"
msgstr "नवीनतम शिकायतें"

msgid "Open complaints"
msgstr "खुली शिकायतें"

msgid "Mail me today's complaints"
msgstr "आज की शिकायतें मुझे मेल करें"

#, python-format
msgid "%(count)s record"
msgid_plural "%(count)s records"
msgstr[0] "%(count)s रिकॉर्ड"
msgstr[1] "%(count)s रिकॉर्ड"

#, python-format
msgid "No records match %(search)s. Try fewer words or another spelling."
msgstr "%(search)s से कोई रिकॉर्ड मेल नहीं खाता। कम शब्द या दूसरी वर्तनी आज़माएँ।"

#, python-format
msgid "Showing the top %(shown)s. Say “mail me this” to get all %(total)s by email."
msgstr "शीर्ष %(shown)s दिखाए जा रहे हैं। सभी %(total)s ईमेल से पाने के लिए “mail me this” लिखें।"

msgid "Say “mail me this” to get them by email."
msgstr "इन्हें ईमेल से पाने के लिए “mail me this” लिखें।"

#, python-format
msgid "Found %(records)s for %(search)s."
msgstr "%(search)s के लिए %(records)s मिले।"

#, python-format
msgid "No records match %(search)s, so no email was sent."
msgstr "%(search)s से कोई रिकॉर्ड मेल नहीं खाता, इसलिए कोई ईमेल नहीं भेजा गया।"

#, python-format
msgid "❌ The email was not sent: %(reason)s"
msgstr "❌ ईमेल नहीं भेजा गया: %(reason)s"

#, python-format
msgid "✅ Sent %(records)s (%(search)s) to %(address)s."
msgstr "✅ %(records)s (%(search)s) %(address)s पर भेजे गए।"

#, python-format
msgid "📎 %(count)s file attached."
msgid_plural "📎 %(count)s files attached."
msgstr[0] "📎 %(count)s फ़ाइल संलग्न की गई।"
msgstr[1] "📎 %(count)s फ़ाइलें संलग्न की गईं।"

#, python-format
msgid "These uploaded files are no longer stored, so they could not be attached: %(files)s."
msgstr "ये अपलोड की गई फ़ाइलें अब संग्रहीत नहीं हैं, इसलिए संलग्न नहीं की जा सकीं: %(files)s।"

#, python-format
msgid "(Emails only go to %(address)s; other addresses are ignored.)"
msgstr "(ईमेल केवल %(address)s पर जाते हैं; दूसरे पते अनदेखे किए जाते हैं।)"

msgid "photo"
msgstr "फ़ोटो"

msgid "earlier complaint copy"
msgstr "पिछली शिकायत की प्रति"

#, python-format
msgid "status %(statuses)s"
msgstr "स्थिति %(statuses)s"

msgid "filed today"
msgstr "आज दर्ज"

msgid "most recent"
msgstr "सबसे हाल की"

msgid "everything"
msgstr "सभी"

