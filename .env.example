# Copy this file to ".env" (next to manage.py) and fill in what you need.
# .env is ignored by git, so keys stay on this computer. Restart the server after editing.
# Real environment variables (systemd, your hosting panel) win over this file.
# A live site needs at least: DJANGO_DEBUG=0 (or remove the line), DJANGO_SECRET_KEY,
# DJANGO_ALLOWED_HOSTS, DATABASE_URL, REDIS_URL, a real SMS_BACKEND and DJANGO_ADMIN_PASSWORD.
# See DEPLOY.md.

# --- Django ---
# DEBUG is OFF unless this says 1. Keep 1 on your own computer; set 0 (or remove it) on a live site.
# With DEBUG off, DJANGO_SECRET_KEY is required (the server refuses to start without it).
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Domain names the site answers to, comma-separated.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full https:// origins for forms posted through a proxy or a second domain, comma-separated.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://grievance.example.gov.in

# Log level for the console (gunicorn/systemd keep it): DEBUG, INFO, WARNING, ERROR.
# DJANGO_LOG_LEVEL=WARNING

# --- HTTPS (all on automatically when DJANGO_DEBUG is off) ---
# Secure cookies, redirect http -> https, and HSTS. Set 0 ONLY to try DEBUG=0 locally over plain http.
# DJANGO_HTTPS=1
# 1 when nginx or the hosting platform ends HTTPS and sends X-Forwarded-Proto (almost always).
# Without it the http -> https redirect loops forever. Never set it if nothing sets that header.
# DJANGO_BEHIND_PROXY=1
# HSTS: how long (seconds) browsers must use HTTPS only. One year = 31536000 (default).
# On a brand-new domain you can start with 3600 and raise it once HTTPS is known to work.
# DJANGO_HSTS_SECONDS=31536000
# Also force HTTPS on every subdomain. Set 0 if any subdomain still serves plain http.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# Allow listing the domain in browsers' built-in HTTPS-only list (hstspreload.org). The header alone
# changes nothing until you submit the domain there; that step is hard to undo. Set 0 to opt out.
# DJANGO_HSTS_PRELOAD=1

# --- Database ---
# Empty = SQLite in db.sqlite3 (fine on your own computer). A live site should use PostgreSQL or MySQL.
# PostgreSQL:
# DATABASE_URL=postgres://citycorp:STRONG-PASSWORD@localhost:5432/citycorp
# Managed databases often need TLS:  ...:5432/citycorp?sslmode=require
# MySQL 8.0.11+ (create the database first, utf8mb4; see DEPLOY.md). Driver mysqlclient (pip install -r requirements-mysql.txt):
# DATABASE_URL=mysql://root:YOUR-PASSWORD@127.0.0.1:3306/citycorp_db
# ...or the pure-Python PyMySQL driver (no compiler needed):
# DATABASE_URL=mysql+pymysql://root:YOUR-PASSWORD@127.0.0.1:3306/citycorp_db
# MySQL connections always use charset utf8mb4 and strict SQL mode.
# DATABASE_URL=

# --- Cache (OTP and admin-login rate limits) ---
# Empty = memory of one process. With several gunicorn workers each would count separately, so a
# live site needs Redis:
# REDIS_URL=redis://localhost:6379/0
# With a password / TLS:  rediss://:PASSWORD@host:6380/0
# REDIS_URL=

# --- Corporation admin account (created by "manage.py migrate") ---
# The demo password 1234 works only while DJANGO_DEBUG=1. With DEBUG off:
#   - "migrate" stops if the admin still has 1234, until DJANGO_ADMIN_PASSWORD is a strong password
#     (8+ characters, not common, not only digits); it then sets that password;
#   - weak passwords are refused at sign-in. Change one later with "manage.py changepassword admin".
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=1234

# --- "Citizen help" assistant: email through Brevo (free plan is enough) ---
# Brevo -> SMTP & API -> API Keys -> Generate. Paste it here yourself; never share it in chat.
BREVO_API_KEY=
# A sender email you verified in Brevo (Brevo -> Senders, Domains & Dedicated IPs -> Senders).
SENDER_EMAIL=
SENDER_NAME=City Corporation
# Emails are ONLY ever sent to this address. It is locked in the code (assistant/brevo.py);
# any other value here stops all emails.
ADMIN_EMAIL=govermentowncorporation@gmail.com

# --- Data ingestion API (POST /api/ingest/, see INGEST_API.md) ---
# Secret key your friend sends in the X-API-Key header. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the ingestion API is switched off.
INGEST_API_KEY=

# --- Citizen SMS (sign-in OTPs and complaint status updates) ---
# console  = SMS is printed in the server console; OTP also shown on the login page (testing only)
# fast2sms | msg91 | twilio = real SMS. Indian numbers need a DLT-registered sender and templates.
SMS_BACKEND=console
# Demo only: with SMS_BACKEND=console, show the citizen OTP on the login page even on a live site.
# Anyone can then sign in as any mobile number. Remove it once a real SMS provider is set up.
# CITIZEN_OTP_ON_SCREEN=1

# Fast2SMS: Dashboard -> Dev API -> API Authorization Key (needs a small wallet recharge)
FAST2SMS_API_KEY=

# MSG91: Authkey + an OTP template containing ##OTP## linked to a DLT-approved template
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Status-update SMS go through the Flow API: a DLT-approved template whose only variable is ##message##
MSG91_SMS_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Agent Work: "Collect data" jobs and TensorFlow training (see ML_SETUP.md) ---
# Where collection jobs run: thread (default here), inline (default on Vercel) or command
# (left queued for "manage.py run_collection_jobs", run by a timer).
# ML_JOB_RUNNER=thread
# A job with no progress for this many seconds (or queued this long) is marked failed.
# ML_JOB_STALE_SECONDS=300
# ML_JOB_QUEUE_TIMEOUT=900
# Tries per job when the database or source fails for a moment.
# ML_JOB_MAX_ATTEMPTS=3
# Where trained models and metrics are saved (empty = ml_artifacts/ next to manage.py).
# ML_ARTIFACTS_DIR=
# ML_MIN_TRAIN_RECORDS=20
# ML_TRAIN_EPOCHS=30
# Optional outside data source: a URL that answers GET with a JSON list of {"id", "text", "label"}.
# The token is sent as "Authorization: Bearer ...". Paste it here yourself; never put it in code.
# ML_HTTP_SOURCE_URL=
# ML_HTTP_SOURCE_TOKEN=
# ML_HTTP_SOURCE_NAME=External source
